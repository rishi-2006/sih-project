# =====================================================
# ORCA — Marine Intelligence Platform Environment Config
# =====================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
DEMO_MODE=True
FRONTEND_URL=http://localhost:3000

# Public API Keys (Leave blank to run in deterministic DEMO_MODE)
OPENWEATHER_API_KEY=your_openweather_api_key_here
INCOIS_API_KEY=your_incois_api_key_here
IMD_API_KEY=your_imd_api_key_here
COPERNICUS_API_KEY=your_copernicus_api_key_here

# PostGIS / PostgreSQL Database Configuration
POSTGIS_HOST=localhost
POSTGIS_PORT=5432
POSTGIS_DB=orca_gis
POSTGIS_USER=postgres
POSTGIS_PASSWORD=postgres_password_here
